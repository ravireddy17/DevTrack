@model DevTrack.Models.TaskItem
@{
    ViewData["Title"] = "DevTrack — Create Task";
}

<div class="form-container">
    <div class="form-header">
        <h2>➕ Create New Task</h2>
        <a asp-action="Index" class="btn-back">← Back to Dashboard</a>
    </div>

    <form asp-action="Create" method="post" class="task-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Title">Task Title *</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Fix fuel tracking API bug" />
            <span asp-validation-for="Title" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the task in detail..."></textarea>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Priority">Priority *</label>
                <select asp-for="Priority" class="form-control">
                    <option value="Low">🟢 Low</option>
                    <option value="Medium" selected>🟡 Medium</option>
                    <option value="High">🔴 High</option>
                </select>
            </div>

            <div class="form-group">
                <label asp-for="Status">Status *</label>
                <select asp-for="Status" class="form-control">
                    <option value="Pending" selected>Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="AssignedTo">Assigned To</label>
                <input asp-for="AssignedTo" class="form-control" placeholder="e.g. Ravi Reddy" />
            </div>

            <div class="form-group">
                <label asp-for="DueDate">Due Date</label>
                <input asp-for="DueDate" type="date" class="form-control" />
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-submit">DevTrack — Create Task</button>
            <a asp-action="Index" class="btn-cancel">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
